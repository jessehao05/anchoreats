# Production reference — these are NOT read from a file.
#
# backend/.env is gitignored and never reaches Render. Set each variable below
# in the Render dashboard under your service's Environment tab. The keys marked
# `sync: false` in render.yaml are the ones Render expects from the dashboard.

# MongoDB Atlas connection string
MONGO_URI=

# Credentials for the /analytics page
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
ANALYTICS_SECRET=

# Allowed CORS origin — the deployed Vercel URL. Required in production:
# without it the code falls back to http://localhost:5173 and blocks the
# real frontend.
FRONTEND_URL=https://anchoreats.vercel.app

# Tells Express to suppress stack traces in error responses. No application
# code reads this, but Express does.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Do NOT set the following in Render.
# ---------------------------------------------------------------------------

# PORT — Render injects this and expects the service to bind to whatever it
# provides. src/server.js already reads process.env.PORT. Hardcoding a value
# fights the platform.
