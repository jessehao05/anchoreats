# Local development — copy this file to backend/.env and fill in the values.
# backend/.env is gitignored, so it only ever affects your local machine.

# MongoDB Atlas connection string
MONGO_URI=

# Credentials for the /analytics page
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
ANALYTICS_SECRET=

# ---------------------------------------------------------------------------
# Leave the following unset in dev — the code defaults are already correct.
# ---------------------------------------------------------------------------

# FRONTEND_URL — allowed CORS origin. Defaults to http://localhost:5173,
# which is Vite's default port. Only set it if Vite starts on a different
# port (it silently falls back to 5174 when 5173 is taken).
# FRONTEND_URL=http://localhost:5173

# PORT — server port. Defaults to 5001, which matches the frontend's default
# API base URL (http://localhost:5001/api).
# PORT=5001

# NODE_ENV — leave unset. Express then treats the app as "development" and
# includes stack traces in error responses, which is what you want locally.
