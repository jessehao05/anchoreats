# Production reference — this is NOT read from a file.
#
# frontend/.env is gitignored and never reaches Vercel.

# Backend base URL — the Render service URL with /api appended. Required in
# production: without it the build falls back to http://localhost:5001/api and
# the deployed site has no working backend. No trailing slash.
VITE_API_URL=https://your-app.onrender.com/api
